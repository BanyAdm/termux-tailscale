#!/data/data/com.termux/files/usr/bin/bash
PKG="com.tailscale.ipn"
RECEIVER="${PKG}/.TermuxPluginReceiver"
VERSION="V1"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

_broadcast() {
    am broadcast -a "${PKG}.${1}" -n "${RECEIVER}" ${@:2} 2>/dev/null
}

cmd_status() {
    if ifconfig 2>/dev/null | grep -q "^tun"; then
        echo -e "${GREEN}[✓]${RESET} Tailscale: Connected"
    else
        echo -e "${RED}[✗]${RESET} Tailscale: Disconnected"
    fi
}

cmd_up() {
    echo -e "${YELLOW}[*]${RESET} Connecting Tailscale..."
    _broadcast CONNECT_VPN
    sleep 5
    cmd_status
}

cmd_down() {
    echo -e "${YELLOW}[*]${RESET} Disconnecting Tailscale..."
    _broadcast DISCONNECT_VPN
    sleep 2
    cmd_status
}

cmd_toggle() {
    if ifconfig 2>/dev/null | grep -q "^tun"; then
        _broadcast DISCONNECT_VPN
    else
        _broadcast CONNECT_VPN
    fi
    sleep 5
    cmd_status
}

cmd_exit_node() {
    local node="${1}"
    local lan="${2:-false}"
    if [[ -z "$node" ]]; then
        echo "Usage: tailscale exit-node <node-name> [allow-lan-access]"
        exit 1
    fi
    echo -e "${YELLOW}[*]${RESET} Setting exit node: $node"
    am broadcast -a "${PKG}.USE_EXIT_NODE" -n "${RECEIVER}" --es exitNode "$node" --ez allowLanAccess "$lan" 2>/dev/null
    sleep 2
    cmd_status
}

cmd_ip() {
    local ip
    ip=$(ifconfig 2>/dev/null | awk '
    /^[a-z0-9]+:/ { iface=$1 }
    /^tun/ { in_tun=1 }
    /inet / && in_tun {
        for (i=1; i<=NF; i++) {
            if ($i == "inet") {
                print $(i+1)
                exit
            }
        }
    }')

    if [[ -n "$ip" ]]; then
        echo -e "${GREEN}[✓]${RESET} Tailscale IP: $ip"
    else
        echo -e "${RED}[✗]${RESET} No Tailscale IP found"
    fi
}

cmd_version() {
    echo -e "${GREEN}Tailscale CLI Version:${RESET} ${VERSION}"
}

usage() {
    echo "Usage: tailscale <command>"
    echo ""
    echo "Commands:"
    echo "  up                              Connect to Tailscale"
    echo "  down                            Disconnect from Tailscale"
    echo "  toggle                          Toggle connection"
    echo "  status                          Show connection status"
    echo "  ip                              Show current Tailscale IP"
    echo "  exit-node <name> [allow-lan]    Set exit node"
    echo "  version                         Show CLI version"
}

case "${1:-}" in
    up)         cmd_up ;;
    down)       cmd_down ;;
    toggle)     cmd_toggle ;;
    status)     cmd_status ;;
    ip)         cmd_ip ;;
    exit-node)  cmd_exit_node "${2:-}" "${3:-false}" ;;
    version)    cmd_version ;;
    *)          usage ;;
esac
