#!/data/data/com.termux/files/usr/bin/bash
PKG="com.tailscale.ipn"
RECEIVER="${PKG}/.TermuxPluginReceiver"
VERSION=$(cat "$HOME/.config/tailscale/version" 2>/dev/null || echo "unknown")

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
DIM='\033[0;37m'
BOLD='\033[1m'
RESET='\033[0m'

_broadcast() {
    am broadcast -a "${PKG}.${1}" -n "${RECEIVER}" ${@:2} 2>/dev/null
}

_is_connected() {
    ifconfig 2>/dev/null | grep -q "^tun"
}

_get_ip() {
    ifconfig 2>/dev/null | awk '/^tun/{in_tun=1} in_tun && /inet /{for(i=1;i<=NF;i++) if($i=="inet") {print $(i+1); exit}}'
}

_require_key() {
    if [[ ! -f ~/.config/tailscale/api_key ]]; then
        echo -e "${RED}[✗]${RESET} No API key found. Run: tailscale login"
        exit 1
    fi
}

_get_devices() {
    curl -s -H "Authorization: Bearer $(cat ~/.config/tailscale/api_key)" \
        "https://api.tailscale.com/api/v2/tailnet/-/devices"
}

cmd_status() {
    if _is_connected; then
        local ip
        ip=$(_get_ip)
        echo -e "${GREEN}[✓]${RESET} Connected — ${CYAN}${ip}${RESET}"
    else
        echo -e "${RED}[✗]${RESET} Disconnected"
        return
    fi
    if [[ ! -f ~/.config/tailscale/api_key ]]; then
        echo -e "${DIM}    Run 'tailscale login' to see tailnet devices${RESET}"
        return
    fi
    local response
    response=$(_get_devices)
    if echo "$response" | grep -q '"error"'; then
        echo -e "${RED}    API error: $(echo "$response" | grep -o '"message":"[^"]*"' | cut -d'"' -f4)${RESET}"
        return
    fi
    echo ""
    echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for d in data.get('devices', []):
    name = d.get('hostname', 'unknown')
    ips = d.get('addresses', [])
    ip = ips[0].split('/')[0] if ips else 'unknown'
    os = d.get('os', '')
    online = d.get('connectedToControl', False)
    dot = '\033[0;32m●\033[0m' if online else '\033[0;37m○\033[0m'
    print(f'  {dot}  {name:<22} \033[0;36m{ip:<18}\033[0m \033[0;37m{os}\033[0m')
"
}

cmd_up() {
    echo -e "${YELLOW}[*]${RESET} Connecting Tailscale..."
    _broadcast CONNECT_VPN
    sleep 5
    cmd_status
}

cmd_down() {
    echo -e "${YELLOW}[*]${RESET} Disconnecting Tailscale..."
    _broadcast DISCONNECT_VPN
    sleep 2
    cmd_status
}

cmd_toggle() {
    if _is_connected; then
        _broadcast DISCONNECT_VPN
    else
        _broadcast CONNECT_VPN
    fi
    sleep 5
    cmd_status
}

cmd_login() {
    echo -e "${YELLOW}[*]${RESET} Opening Tailscale API keys page..."
    termux-open-url "https://login.tailscale.com/admin/settings/keys"
    echo -e "${YELLOW}[*]${RESET} Generate an API key (tskey-api-...) and paste it here:"
    read -r apikey
    if [[ -z "$apikey" ]]; then
        echo -e "${RED}[✗]${RESET} No key entered"
        exit 1
    fi
    mkdir -p ~/.config/tailscale && echo "$apikey" > ~/.config/tailscale/api_key
    chmod 600 ~/.config/tailscale/api_key
    echo -e "${GREEN}[✓]${RESET} API key saved"
}

cmd_logout() {
    if [[ ! -f ~/.config/tailscale/api_key ]]; then
        echo -e "${RED}[✗]${RESET} Not logged in"
        exit 1
    fi
    rm -f ~/.config/tailscale/api_key
    echo -e "${GREEN}[✓]${RESET} Logged out"
}

cmd_ping() {
    local host="${1}"
    if [[ -z "$host" ]]; then
        echo "Usage: tailscale ping <hostname|ip>"
        exit 1
    fi
    if ! _is_connected; then
        echo -e "${RED}[✗]${RESET} Not connected to Tailscale"
        exit 1
    fi
    echo -e "${YELLOW}[*]${RESET} Pinging ${host}..."
    ping -c 4 "$host"
}

cmd_whois() {
    local target="${1}"
    if [[ -z "$target" ]]; then
        echo "Usage: tailscale whois <ip|hostname>"
        exit 1
    fi
    _require_key
    local response
    response=$(_get_devices)
    if echo "$response" | grep -q '"error"'; then
        echo -e "${RED}[✗]${RESET} API error: $(echo "$response" | grep -o '"message":"[^"]*"' | cut -d'"' -f4)"
        exit 1
    fi
    echo "$response" | python3 -c "
import sys, json
target = '$target'
data = json.load(sys.stdin)
for d in data.get('devices', []):
    name = d.get('hostname', '')
    ips = d.get('addresses', [])
    ip = ips[0].split('/')[0] if ips else ''
    if target == ip or target.lower() == name.lower():
        print(f'\033[1mMachine\033[0m')
        print(f'  Name   : {name}')
        print(f'  ID     : {d.get(\"id\", \"\")}')
        print(f'  OS     : {d.get(\"os\", \"\")}')
        print(f'  IP     : {ip}')
        print(f'  Online : {d.get(\"connectedToControl\", False)}')
        print(f'  Last seen: {d.get(\"lastSeen\", \"\")}')
        print(f'\033[1mUser\033[0m')
        print(f'  {d.get(\"user\", \"unknown\")}')
        sys.exit(0)
print('No match found for: ' + target)
"
}

cmd_ip() {
    local ip
    ip=$(_get_ip)
    if [[ -n "$ip" ]]; then
        echo -e "${GREEN}[✓]${RESET} Tailscale IP: ${CYAN}${ip}${RESET}"
    else
        echo -e "${RED}[✗]${RESET} No Tailscale IP found"
    fi
}

cmd_netcheck() {
    echo -e "${YELLOW}[*]${RESET} Checking network conditions..."
    echo ""
    local ipv4 ipv6 udp
    ipv4=$(curl -4 -s --max-time 3 https://ifconfig.me 2>/dev/null)
    ipv6=$(curl -6 -s --max-time 3 https://ifconfig.me 2>/dev/null)
    [[ -n "$ipv4" ]] && echo -e "  IPv4 : ${CYAN}${ipv4}${RESET}" || echo -e "  IPv4 : ${DIM}unavailable${RESET}"
    [[ -n "$ipv6" ]] && echo -e "  IPv6 : ${CYAN}${ipv6}${RESET}" || echo -e "  IPv6 : ${DIM}unavailable${RESET}"
    echo ""
    echo -e "  ${BOLD}DERP latency:${RESET}"
    declare -A derp_servers=(
        ["sin"]="derp1.tailscale.com"
        ["sea"]="derp3.tailscale.com"
        ["sfo"]="derp4.tailscale.com"
        ["nyc"]="derp5.tailscale.com"
        ["lhr"]="derp7.tailscale.com"
        ["fra"]="derp10.tailscale.com"
        ["syd"]="derp8.tailscale.com"
    )
    for region in sin sea sfo nyc lhr fra syd; do
        host="${derp_servers[$region]}"
        ms=$(curl -o /dev/null -s -w "%{time_connect}" --max-time 3 "https://${host}/derp/probe" 2>/dev/null)
        if [[ -n "$ms" && "$ms" != "0.000000" ]]; then
            ms_int=$(python3 -c "print(int(float('$ms') * 1000))")
            echo -e "    ${GREEN}${region}${RESET}: ${ms_int}ms"
        else
            echo -e "    ${DIM}${region}: timeout${RESET}"
        fi
    done
}

cmd_exit_node() {
    local subcmd="${1}"
    case "$subcmd" in
        list)
            _require_key
            local response
            response=$(_get_devices)
            echo -e "${CYAN}Available exit nodes:${RESET}"
            echo "$response" | python3 -c "
import sys, json
data = json.load(sys.stdin)
found = False
for d in data.get('devices', []):
    routes = d.get('advertisedRoutes', [])
    if '0.0.0.0/0' in routes or '::/0' in routes:
        name = d.get('hostname', 'unknown')
        ips = d.get('addresses', [])
        ip = ips[0].split('/')[0] if ips else 'unknown'
        online = d.get('connectedToControl', False)
        dot = '\033[0;32m●\033[0m' if online else '\033[0;37m○\033[0m'
        print(f'  {dot}  {name:<22} {ip}')
        found = True
if not found:
    print('  No exit nodes found')
"
            ;;
        off)
            echo -e "${YELLOW}[*]${RESET} Clearing exit node..."
            am broadcast -a "${PKG}.USE_EXIT_NODE" -n "${RECEIVER}" --es exitNode "" --ez allowLanAccess false 2>/dev/null
            sleep 2
            cmd_status
            ;;
        "")
            echo "Usage: tailscale exit-node <list|off|<name>> [allow-lan]"
            ;;
        *)
            local lan="${2:-false}"
            echo -e "${YELLOW}[*]${RESET} Setting exit node: $subcmd"
            am broadcast -a "${PKG}.USE_EXIT_NODE" -n "${RECEIVER}" --es exitNode "$subcmd" --ez allowLanAccess "$lan" 2>/dev/null
            sleep 2
            cmd_status
            ;;
    esac
}

cmd_webclient() {
    local action="${1:-}"
    if [[ "$action" == "false" ]]; then
        pkill -f "tailscale-web/server.py" 2>/dev/null
        return
    fi
    if ! _is_connected; then
        echo -e "${RED}[✗]${RESET} Not connected to Tailscale"
        exit 1
    fi
    if pgrep -f "tailscale-web/server.py" > /dev/null 2>&1; then
        echo -e "${YELLOW}[*]${RESET} Web client already running"
        return
    fi
    local ip
    ip=$(_get_ip)
    nohup python3 ~/.local/share/tailscale-web/server.py > /dev/null 2>&1 &
    sleep 1
    echo -e "${GREEN}[✓]${RESET} Web client running at ${CYAN}http://${ip}:5252${RESET}"
}

cmd_update() {
    local remote_version
    remote_version=$(curl -s "https://raw.githubusercontent.com/banyadm/termux-tailscale/main/VERSION")
    if [[ -z "$remote_version" ]]; then
        echo -e "${RED}[✗]${RESET} Could not check for updates"
        return
    fi
    if [[ "$remote_version" == "$VERSION" ]]; then
        echo -e "${GREEN}[✓]${RESET} Already up to date (${VERSION})"
        return
    fi
    echo -e "${YELLOW}[*]${RESET} Updating Termux:Tailscale ${VERSION} to ${remote_version}..."
    bash <(curl -Lf https://raw.githubusercontent.com/banyadm/termux-tailscale/main/update.sh)
    echo -e "${GREEN}[✓]${RESET} Updated to ${remote_version}"
}

cmd_version() {
    echo -e "${GREEN}Tailscale CLI Version:${RESET} ${VERSION}"
}

usage() {
    echo -e "${BOLD}Usage:${RESET} tailscale <command>"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo "  up                              Connect to Tailscale"
    echo "  down                            Disconnect from Tailscale"
    echo "  toggle                          Toggle connection"
    echo "  status                          Show connection status and tailnet devices"
    echo "  ip                              Show current Tailscale IP"
    echo "  ping <host>                     Ping a tailnet device"
    echo "  whois <ip|hostname>             Show info about a tailnet device"
    echo "  netcheck                        Check network conditions and DERP latency"
    echo "  exit-node list                  List available exit nodes"
    echo "  exit-node off                   Disable exit node"
    echo "  exit-node <name> [allow-lan]    Set exit node"
    echo "  login                           Save Tailscale API key"
    echo "  logout                          Remove saved API key"
    echo "  webclient                       Start web interface on port 5252"
    echo "  set --webclient                 Start web interface in background"
    echo "  set --webclient=false           Stop web interface"
    echo "  update                          Update to latest version"
    echo "  version                         Show CLI version"
}

case "${1:-}" in
    up)         cmd_up ;;
    down)       cmd_down ;;
    toggle)     cmd_toggle ;;
    status)     cmd_status ;;
    ip)         cmd_ip ;;
    ping)       cmd_ping "${2:-}" ;;
    whois)      cmd_whois "${2:-}" ;;
    netcheck)   cmd_netcheck ;;
    exit-node)  cmd_exit_node "${2:-}" "${3:-false}" ;;
    login)      cmd_login ;;
    logout)     cmd_logout ;;
    webclient)  cmd_webclient ;;
    set)
        case "${2:-}" in
            --webclient) cmd_webclient ;;
            --webclient=false) cmd_webclient false ;;
            *) echo "Usage: tailscale set --webclient[=false]" ;;
        esac
        ;;
    update)     cmd_update ;;
    version)    cmd_version ;;
    *)          usage ;;
esac
